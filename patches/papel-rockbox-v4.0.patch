+/* custom: ASCII + Latin-1 (UTF-8 C3 xx) case change in place; byte lengths don't change */
+static void skin_change_case(char *s, bool upper)
+{
+    unsigned char *p = (unsigned char *)s;
+    for (; *p; p++)
+    {
+        if (upper && *p >= 'a' && *p <= 'z')
+            *p -= 'a' - 'A';
+        else if (!upper && *p >= 'A' && *p <= 'Z')
+            *p += 'a' - 'A';
+        else if (*p == 0xC3 && p[1])
+        {
+            p++;
+            if (upper && *p >= 0xA0 && *p <= 0xBE && *p != 0xB7)
+                *p -= 0x20;
+            else if (!upper && *p >= 0x80 && *p <= 0x9E && *p != 0x97)
+                *p += 0x20;
+        }
+    }
+}
