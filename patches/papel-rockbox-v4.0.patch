+static void skin_space_letters(char *s, int cap)
+{
+    static char tmp[MAX_PATH * 2];
+    const unsigned char *p = (const unsigned char *)s;
+    unsigned short prev = 0, ucs;
+    int n = 0;
+
+    if (cap > (int)sizeof(tmp))
+        cap = sizeof(tmp);
+    while (*p)
