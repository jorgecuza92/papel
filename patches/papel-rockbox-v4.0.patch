+/* local test hack: RB_KEYS="3000 Down F5 Return 500 F5 +Right 2000 -Right"
+   (ms delays / SDL key names, +key = hold, -key = release) */
+static int scripted_keys(void *data)
+{
+    char buf[1024], *tok, *save;
+    (void)data;
+    strlcpy(buf, getenv("RB_KEYS"), sizeof(buf));
+    for (tok = strtok_r(buf, " ", &save); tok; tok = strtok_r(NULL, " ", &save))
+    {
+        if (isdigit((unsigned char)tok[0]))
+        {
+            SDL_Delay(atoi(tok));
+            continue;
+        }
+        SDL_Event e = { 0 };
+        if (tok[0] == '+' || tok[0] == '-')
+        {
+            e.type = tok[0] == '+' ? SDL_KEYDOWN : SDL_KEYUP;
+            e.key.keysym.sym = SDL_GetKeyFromName(tok + 1);
+            SDL_PushEvent(&e);
+            continue;
+        }
+        e.type = SDL_KEYDOWN;
+        e.key.keysym.sym = SDL_GetKeyFromName(tok);
+        SDL_PushEvent(&e);
+        SDL_Delay(60);
+        e.type = SDL_KEYUP;
+        SDL_PushEvent(&e);
+        SDL_Delay(250);
+    }
+    return 0;
+}
