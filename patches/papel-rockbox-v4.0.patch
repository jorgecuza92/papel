diff --git a/apps/gui/skin_engine/skin_display.c b/apps/gui/skin_engine/skin_display.c
index 53efc1f..029490f 100644
--- a/apps/gui/skin_engine/skin_display.c
+++ b/apps/gui/skin_engine/skin_display.c
@@ -269,6 +269,34 @@ void draw_progressbar(struct gui_wps *gwps, struct skin_viewport* skin_viewport,
         flags |= INNER_NOFILL;
     }
 
+    /* custom: one dot per item, lit up to the current one; squeezed (then scaled) if they don't fit */
+    if (pb->dots && pb->type == SKIN_TOKEN_LIST_SCROLLBAR &&
+        SKINOFFSETTOPTR(get_skin_buffer(gwps->data), pb->image) &&
+        SKINOFFSETTOPTR(get_skin_buffer(gwps->data), pb->backdrop))
+    {
+        struct gui_img *on = SKINOFFSETTOPTR(get_skin_buffer(gwps->data), pb->image);
+        struct gui_img *off = SKINOFFSETTOPTR(get_skin_buffer(gwps->data), pb->backdrop);
+        int d = on->bm.width, n = length, cur = end, pitch = 2 * d, i;
+
+        on->bm.data = core_get_data(on->buflib_handle);
+        off->bm.data = core_get_data(off->buflib_handle);
+        if (n > 1 && (width - d) / (n - 1) < pitch)
+            pitch = (width - d) / (n - 1);
+        if (pitch < d + 1)
+        {
+            pitch = d + 1;
+            n = (width - d) / pitch + 1;
+            cur = length ? (int)(end * n / length) : 0;
+        }
+        screen_clear_area(display, x, y, width, height);
+        for (i = 0; i < n; i++)
+        {
+            struct gui_img *img = i <= cur ? on : off;
+            display->bmp_part(&img->bm, 0, 0, x + i * pitch, y, d, img->bm.height);
+        }
+        return;
+    }
+
     if (pb->noborder)
     {
