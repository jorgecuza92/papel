+        if (i < len && ((unsigned char)s[i] & 0xC0) == 0x80)
+            continue;
+        if (skin_text_width(s, i, font) > width)
+            break;
+        fit = i;
+    }
+    for (i = fit; i > 0; i--)
+        if (s[i] == ' ') { sp = i; break; }
+    if (sp > 0 && skin_text_width(s, sp, font) * 10 >= width * 6)
+    {
+        *cut = sp;
+        while (s[sp] == ' ')
+            sp++;
+        return sp;
+    }
+    {
+        int dash = skin_text_width("-", 1, font);
+        int k = fit, ws;
+        while (k > 0 && skin_text_width(s, k, font) + dash > width)
+            k = skin_prev_char(s, k);
+        for (ws = k; ws > 0 && s[ws - 1] != ' '; ws--)
+            ;
+        /* keep 2+ letters of the word on line 2 */
+        while (k - ws > 2 && (s[k] == '\0' || s[k + 1] == '\0' || s[k + 1] == ' '))
+            k = skin_prev_char(s, k);
+        if (k - ws >= 2 && s[k] != ' ' && s[k] != '\0')
+        {
+            *cut = k;
+            *hyph = (s[k - 1] != '-');
+            return k;
+        }
+    }
+    if (sp > 0)
+    {
+        *cut = sp;
+        while (s[sp] == ' ')
+            sp++;
+        return sp;
+    }
+    *cut = fit;
+    return fit;
