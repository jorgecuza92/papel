+                tmp[n++] = 0xC2;
+                tmp[n++] = 0x80 + k;
+            }
+        }
+        if (n + len >= cap - 1)
+            break;
+        memcpy(&tmp[n], p, len);
+        n += len;
+        prev = ucs;
+        p = next;
+    }
+    tmp[n] = '\0';
+    memcpy(s, tmp, n + 1);
+}
