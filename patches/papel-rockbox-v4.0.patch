+int spacer_width( FT_Long code )
+{
+    if (!jitter || code < 0x81 || code > 0x8F)
+        return 0;
+    if (code <= 0x85)
+        return 1;
+    return 2 + ((code - 0x86) * (2 * jitter - 2) + 4) / 9;
