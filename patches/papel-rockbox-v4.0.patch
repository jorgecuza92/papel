+   letters, picked per pair, so letter spacing is uneven but text next to it stays evenly spaced */
+/* custom: width in pixels of the first len bytes of s in font */
+static int skin_text_width(const char *s, int len, int font)
+{
+    char tmp[MAX_PATH];
+    int w = 0, h;
+    if (len >= (int)sizeof(tmp))
+        len = sizeof(tmp) - 1;
+    memcpy(tmp, s, len);
+    tmp[len] = '\0';
+    font_getstringsize((const unsigned char *)tmp, &w, &h, font);
+    return w;
+}
+
+static int skin_prev_char(const char *s, int i)
+{
+    i--;
+    while (i > 0 && ((unsigned char)s[i] & 0xC0) == 0x80)
+        i--;
+    return i;
+}
+
+/* custom: where to wrap s so the first line fits width. Returns the byte where line 2 starts;
+ * *cut = bytes kept on line 1, *hyph = line 1 needs a trailing hyphen.
+ * Breaks at a space if line 1 stays at least 60% full, else mid-word with a hyphen
+ * (at least 2 letters of the word on each side). */
+static int skin_wrap_point(const char *s, int font, int width, int *cut, bool *hyph)
+{
+    int len = strlen(s), fit = 0, sp = -1, i;
+    *hyph = false;
+    if (skin_text_width(s, len, font) <= width)
